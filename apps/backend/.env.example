# Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_publishable_or_anon_key
# Secret server-side key. Never expose it in the browser, README, or version control.
SUPABASE_SERVICE_ROLE_KEY=your_secret_service_role_key

# Comma-separated frontend origins for local/dev or separate deployments
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
APP_URL=http://127.0.0.1:8000

# Optional Postgres pooler URLs for tools that connect directly to PostgreSQL.
# The FastAPI app currently uses Supabase Auth/Data API keys above, not these URLs.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_DATABASE_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.PROJECT_REF:YOUR_DATABASE_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres